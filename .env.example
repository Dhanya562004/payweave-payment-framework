# PayWeave Environment Variables Example
# Note: PayWeave includes 100% deterministic offline fallback.
# All features work out of the box WITHOUT any API keys.

# Optional AI LLM API Keys (Gemini, Groq, Together AI)
GEMINI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=

# Server Ports
STREAMLIT_PORT=8501
FASTAPI_PORT=8000
